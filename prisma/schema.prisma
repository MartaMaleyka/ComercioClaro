generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// Convenciones:
// - Montos de dinero: Decimal(12,2). Costos unitarios: Decimal(12,4).
// - Cantidades y existencias: Decimal(12,3) para permitir venta a granel (kg, l).

enum Role {
  OWNER
  CASHIER
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  CREDIT
  YAPPY
  GIFT_CARD
  // Venta cobrada con varias formas de pago (el detalle está en SalePayment)
  MIXED
}

enum DocStatus {
  ACTIVE
  CANCELLED
}

enum ProductUnit {
  PIECE
  KG
  G
  L
  ML
  M
  // Panamá vende por libra; onza y galón para granel y líquidos
  LB
  OZ
  GAL
}

enum StockMovementType {
  INITIAL
  SALE
  SALE_CANCEL
  SALE_RETURN
  PURCHASE
  PURCHASE_CANCEL
  ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
}

enum AdjustmentReason {
  COUNT
  WASTE
  EXPIRED
  THEFT
  DAMAGED
  OTHER
}

enum CashMovementType {
  IN
  OUT
}

enum InvoiceKind {
  INDIVIDUAL
  GLOBAL
}

enum InvoiceStatus {
  PENDING
  STAMPED
  CANCELLED
  ERROR
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  name               String
  // Se incrementa al cambiar contraseña o cerrar todas las sesiones para invalidar JWT emitidos.
  tokenVersion       Int       @default(0)
  mustChangePassword Boolean   @default(false)
  // Idioma de la interfaz: es, zh, en
  language           String    @default("es")
  resetTokenHash     String?   @unique
  resetExpires       DateTime?
  // Confirmación del correo (enlace con token de un solo uso)
  emailVerifiedAt    DateTime?
  emailVerifyHash    String?   @unique
  emailVerifyExpires DateTime?
  // Aceptación de los términos y el aviso de privacidad (Ley 81 de 2019): cuándo y qué versión
  termsAcceptedAt    DateTime?
  termsVersion       String?
  // Administrador de la plataforma: planes, negocios, funciones y usuarios
  isSuperAdmin       Boolean   @default(false)
  // Usuario bloqueado por el administrador: no puede iniciar sesión
  disabledAt         DateTime?
  // Último inicio de sesión (para el panel del super admin)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  memberships Membership[]
}

model Membership {
  id         String   @id @default(cuid())
  role       Role     @default(OWNER)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, businessId])
  @@index([businessId])
}

model Business {
  id                    String         @id @default(cuid())
  name                  String
  description           String?
  phone                 String?
  address               String?
  // País (ISO 3166-1): define impuestos, facturación y formatos por defecto
  country               String         @default("MX")
  currency              String         @default("MXN")
  // Panamá: mostrar montos como B/. (balboa a la par del dólar)
  showBalboa            Boolean        @default(false)
  locale                String         @default("es-MX")
  timezone              String         @default("America/Mexico_City")
  lowStockEmailAlerts   Boolean        @default(false)
  // Datos fiscales Panamá
  ruc                   String?
  dv                    String?
  // Usa el facturador gratuito de la DGI (se vigilan sus límites)
  usesFreeInvoicer      Boolean        @default(false)
  // Yappy: número o nombre en el directorio y QR estático (data URL)
  yappyDirectory        String?
  yappyQr               String?
  // Comisiones por medio de pago (fracción, p. ej. 0.0107 = 1.07%)
  cardFeeRate           Decimal        @default(0) @db.Decimal(6, 4)
  transferFeeRate       Decimal        @default(0) @db.Decimal(6, 4)
  yappyFeeRate          Decimal        @default(0.0107) @db.Decimal(6, 4)
  // Yappy: STATIC (QR fijo del comercio) o API (cobro con confirmación automática)
  yappyMode             String         @default("STATIC")
  // Factura electrónica: OFF, MANUAL (se registra el CUFE) o PAC (emisión automática)
  einvoiceMode          String         @default("MANUAL")
  einvoiceProvider      String?
  // Emitir la factura de cada venta automáticamente (modo PAC)
  autoInvoice           Boolean        @default(false)
  // Contar cada venta como documento para los límites del facturador gratuito
  invoicePerSale        Boolean        @default(false)
  // Programa de lealtad
  loyaltyEnabled        Boolean        @default(false)
  loyaltyPointsPerUnit  Decimal        @default(1) @db.Decimal(8, 2)
  loyaltyPointValue     Decimal        @default(0.01) @db.Decimal(8, 4)
  // Catálogo público con pedidos por WhatsApp
  catalogEnabled        Boolean        @default(false)
  catalogSlug           String?        @unique
  catalogWhatsapp       String?
  // Recargas y pagos de servicios que se cobran: [{ name, kind, commissionRate }]
  serviceProviders      Json?
  // Modo restaurante: cuentas abiertas (mesas) y pantalla de cocina
  restaurantMode        Boolean        @default(false)
  openOrderCounter      Int            @default(0)
  // Perfil regional (Panamá): CAPITAL o INTERIOR; ajusta valores recomendados
  region                String?
  // Días que se aceptan ventas hechas sin conexión al sincronizar
  offlineDays           Int            @default(7)
  // Descuento obligatorio de jubilados (Ley 6 de 1987), p. ej. 0.25 en restaurantes
  seniorDiscountRate    Decimal        @default(0) @db.Decimal(5, 4)
  // Zonas de entrega: [{ name, fee, productId }]
  deliveryZones         Json?
  // Parámetros de planilla (tasas de CSS, seguro educativo, ISR...): ver src/lib/payroll.ts
  payrollSettings       Json?
  // Etiquetas de balanza EAN-13 (prefijo 20-29): ver src/lib/scale.ts
  weightBarcode         Json?
  // Datos fiscales (CFDI 4.0)
  rfc                   String?
  legalName             String?
  taxRegime             String?
  postalCode            String?
  // Contadores para folios consecutivos por negocio
  saleCounter           Int            @default(0)
  purchaseCounter       Int            @default(0)
  orderCounter          Int            @default(0)
  purchaseOrderCounter  Int            @default(0)
  // Suscripción: plan, estado y vigencia (los administra el super admin)
  planId                String?
  plan                  Plan?          @relation(fields: [planId], references: [id], onDelete: SetNull)
  status                BusinessStatus @default(ACTIVE)
  trialEndsAt           DateTime?
  // Pagado hasta esta fecha (se extiende al registrar un pago)
  paidUntil             DateTime?
  billingCycle          BillingCycle   @default(MONTHLY)
  suspendedReason       String?
  // Registro: tipo de negocio (sugiere configuración y primeros pasos) y cómo llegó
  businessType          String?
  // SELF = se registró solo; ADMIN = lo dio de alta el super admin
  signupSource          String?
  // El dueño ocultó la guía de primeros pasos
  onboardingDismissedAt DateTime?
  // Fin de prueba para el que ya se envió el aviso por correo
  trialNoticeFor        DateTime?
  // Cobro automático de la suscripción (ver docs/plan-suscripcion.md)
  autoRenew             Boolean        @default(false)
  // Cliente y método de pago guardados en el proveedor (Stripe: cus_…, pm_…)
  billingCustomerId     String?
  billingMethodId       String?
  // Tarjeta para mostrar: "Visa •••• 4242"
  billingCardLabel      String?
  // Cobros fallidos seguidos y cuándo se reintenta
  billingFailures       Int            @default(0)
  nextChargeAt          DateTime?
  // Vencimiento para el que ya se envió el aviso de cobro y el de suspensión
  renewalNoticeFor      DateTime?
  suspensionNoticeFor   DateTime?
  // Baja: cuándo y por qué (los datos se conservan)
  closedAt              DateTime?
  closedReason          String?
  // Suspendido por falta de pago (se reactiva al pagar en línea)
  suspendedByBilling    Boolean        @default(false)
  // Funciones activadas o desactivadas a mano sobre las del plan: { "promotions": false }
  featureOverrides      Json?
  adminNotes            String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  memberships          Membership[]
  subscriptionPayments SubscriptionPayment[]
  subscriptionCharges  SubscriptionCharge[]
  categories           Category[]
  products             Product[]
  customers            Customer[]
  customerPayments     CustomerPayment[]
  suppliers            Supplier[]
  sales                Sale[]
  saleReturns          SaleReturn[]
  purchases            Purchase[]
  batches              ProductBatch[]
  stockMovements       StockMovement[]
  cashSessions         CashSession[]
  cashMovements        CashMovement[]
  expenses             Expense[]
  invoices             Invoice[]
  auditLogs            AuditLog[]
  yappyCharges         YappyCharge[]
  promotions           Promotion[]
  inventoryCounts      InventoryCount[]
  customerDisplays     CustomerDisplay[]
  onlineOrders         OnlineOrder[]
  purchaseOrders       PurchaseOrder[]
  transfersOut         StockTransfer[]       @relation("TransferFrom")
  transfersIn          StockTransfer[]       @relation("TransferTo")
  serviceSales         ServiceSale[]
  giftCards            GiftCard[]
  giftCardMoves        GiftCardTransaction[]
  openOrders           OpenOrder[]
  recipeItems          RecipeItem[]
  supplierBills        SupplierBill[]
  supplierPayments     SupplierPayment[]
  recurringExpenses    RecurringExpense[]
  ownerTransactions    OwnerTransaction[]
  accountingPeriods    AccountingPeriod[]
  employees            Employee[]
  payrollRuns          PayrollRun[]
  salaryAdvances       SalaryAdvance[]
  coupons              Coupon[]
  campaigns            Campaign[]
}

model Category {
  id         String      @id @default(cuid())
  name       String
  businessId String
  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products   Product[]
  promotions Promotion[]

  @@unique([businessId, name])
}

model Product {
  id              String      @id @default(cuid())
  name            String
  description     String?
  sku             String?
  barcode         String?
  unit            ProductUnit @default(PIECE)
  price           Decimal     @db.Decimal(12, 2)
  wholesalePrice  Decimal?    @db.Decimal(12, 2)
  wholesaleMinQty Decimal?    @db.Decimal(12, 3)
  // Costo promedio ponderado
  cost            Decimal     @default(0) @db.Decimal(12, 4)
  stock           Decimal     @default(0) @db.Decimal(12, 3)
  minStock        Decimal     @default(5) @db.Decimal(12, 3)
  trackExpiry     Boolean     @default(false)
  // Unidades por caja/paquete al comprar (venta suelta)
  packSize        Int?
  // Variantes: productos del mismo grupo (p. ej. "Camiseta básica") con su etiqueta ("M / Azul")
  variantGroup    String?
  variantLabel    String?
  // Extras que se pueden agregar al vender: [{ id, name, price }]
  modifiers       Json?
  // En modo restaurante, se envía a la pantalla de cocina al guardarse en una cuenta
  sendToKitchen   Boolean     @default(false)
  // Si es false no se controla la existencia (servicios, cargos de entrega)
  trackStock      Boolean     @default(true)
  // Aplica el descuento de jubilado (en farmacias, solo medicamentos)
  seniorEligible  Boolean     @default(true)
  // Insumo: se usa en recetas y se compra, pero no se vende en la caja
  isIngredient    Boolean     @default(false)
  // Porciones que rinde la receta (las cantidades de la receta se dividen entre este número)
  recipeYield     Decimal?    @db.Decimal(12, 3)
  // Impuestos (los precios incluyen impuestos)
  taxRate         Decimal     @default(0.16) @db.Decimal(5, 4)
  iepsRate        Decimal     @default(0) @db.Decimal(5, 4)
  satProductKey   String      @default("01010101")
  satUnitKey      String      @default("H87")
  categoryId      String?
  category        Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  businessId      String
  business        Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  archivedAt      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  saleItems      SaleItem[]
  purchaseItems  PurchaseItem[]
  returnItems    SaleReturnItem[]
  batches        ProductBatch[]
  stockMovements StockMovement[]
  promotions     Promotion[]
  countLines     InventoryCountLine[]
  orderLines     PurchaseOrderLine[]
  openOrderItems OpenOrderItem[]
  recipeItems    RecipeItem[]         @relation("RecipeDish")
  usedInRecipes  RecipeItem[]         @relation("RecipeIngredient")
  consumedIn     SaleItemIngredient[]

  @@unique([businessId, barcode])
  @@index([businessId, archivedAt, name])
  @@index([categoryId])
  @@index([businessId, variantGroup])
}

model Customer {
  id               String    @id @default(cuid())
  name             String
  phone            String?
  email            String?
  notes            String?
  creditLimit      Decimal   @default(0) @db.Decimal(12, 2)
  // Días de crédito para calcular el vencimiento del fiado
  creditDays       Int       @default(15)
  // DAYS (creditDays), QUINCENA (15 o fin de mes) o FIXED (fecha fija, p. ej. la cosecha)
  creditTerm       String    @default("DAYS")
  creditDueDate    DateTime?
  // Jubilado o pensionado: se le aplica el descuento de ley
  isSenior         Boolean   @default(false)
  // Número de cédula o carné (no se guarda foto del documento)
  seniorId         String?
  // Puntos de lealtad acumulados
  points           Int       @default(0)
  // Ley 81 de 2019: acepta recibir promociones por WhatsApp (y cuándo lo aceptó)
  marketingConsent Boolean   @default(false)
  consentAt        DateTime?
  // Cumpleaños (día calendario) y etiquetas libres para campañas
  birthday         DateTime?
  tags             String[]  @default([])
  // Saldo pendiente de fiado (se actualiza en la misma transacción que ventas y abonos)
  balance          Decimal   @default(0) @db.Decimal(12, 2)
  rfc              String?
  legalName        String?
  taxRegime        String?
  postalCode       String?
  ruc              String?
  dv               String?
  businessId       String
  business         Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sales              Sale[]
  payments           CustomerPayment[]
  invoices           Invoice[]
  campaignRecipients CampaignRecipient[]

  @@index([businessId, archivedAt, name])
}

model CustomerPayment {
  id            String        @id @default(cuid())
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  notes         String?
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  businessId    String
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  cashSessionId String?
  cashSession   CashSession?  @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  userId        String?
  createdAt     DateTime      @default(now())

  @@index([customerId, createdAt])
  @@index([businessId, createdAt])
}

model Supplier {
  id         String    @id @default(cuid())
  name       String
  contact    String?
  phone      String?
  email      String?
  notes      String?
  // Días de crédito que da el proveedor (vencimiento por defecto de sus facturas)
  creditDays Int       @default(30)
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  purchases      Purchase[]
  purchaseOrders PurchaseOrder[]
  bills          SupplierBill[]

  @@index([businessId, archivedAt, name])
}

model Sale {
  id               String        @id @default(cuid())
  folio            Int
  // Identificador generado por el cliente para evitar duplicados al sincronizar ventas sin conexión
  clientRequestId  String?
  status           DocStatus     @default(ACTIVE)
  paymentMethod    PaymentMethod @default(CASH)
  subtotal         Decimal       @db.Decimal(12, 2)
  discount         Decimal       @default(0) @db.Decimal(12, 2)
  total            Decimal       @db.Decimal(12, 2)
  // Costo de lo vendido (COGS) calculado con el costo promedio al momento de la venta
  costTotal        Decimal       @default(0) @db.Decimal(12, 2)
  amountReceived   Decimal?      @db.Decimal(12, 2)
  change           Decimal?      @db.Decimal(12, 2)
  // Número de operación (Yappy, transferencia, voucher de tarjeta)
  paymentReference String?
  // Vencimiento del fiado
  dueDate          DateTime?
  // Lealtad: puntos ganados y canjeados en la venta
  pointsEarned     Int           @default(0)
  pointsRedeemed   Int           @default(0)
  pointsDiscount   Decimal       @default(0) @db.Decimal(12, 2)
  // Descuento de jubilado aplicado (Ley 6) y cédula o carné presentado
  seniorDiscount   Decimal       @default(0) @db.Decimal(12, 2)
  seniorId         String?
  // Cupón aplicado y su descuento (se resta después del descuento general)
  couponId         String?
  coupon           Coupon?       @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponDiscount   Decimal       @default(0) @db.Decimal(12, 2)
  yappyCharge      YappyCharge?
  onlineOrder      OnlineOrder?
  openOrder        OpenOrder?
  // Vale con el que se pagó la venta
  giftCardId       String?
  giftCard         GiftCard?     @relation(fields: [giftCardId], references: [id], onDelete: SetNull)
  notes            String?
  customerId       String?
  customer         Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  cashSessionId    String?
  cashSession      CashSession?  @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  invoiceId        String?
  invoice          Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  userId           String?
  cancelledAt      DateTime?
  cancelReason     String?
  businessId       String
  business         Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  items    SaleItem[]
  returns  SaleReturn[]
  payments SalePayment[]

  @@unique([businessId, folio])
  @@unique([businessId, clientRequestId])
  @@index([businessId, createdAt])
  @@index([businessId, status, createdAt])
  @@index([customerId])
  @@index([cashSessionId])
  @@index([invoiceId])
}

model SaleItem {
  id                String     @id @default(cuid())
  quantity          Decimal    @db.Decimal(12, 3)
  returnedQuantity  Decimal    @default(0) @db.Decimal(12, 3)
  unitPrice         Decimal    @db.Decimal(12, 2)
  discount          Decimal    @default(0) @db.Decimal(12, 2)
  subtotal          Decimal    @db.Decimal(12, 2)
  unitCost          Decimal    @default(0) @db.Decimal(12, 4)
  taxRate           Decimal    @default(0.16) @db.Decimal(5, 4)
  iepsRate          Decimal    @default(0) @db.Decimal(5, 4)
  // Descuento aplicado por una promoción (incluido en discount)
  promotionDiscount Decimal    @default(0) @db.Decimal(12, 2)
  // Descuento de jubilado del renglón (incluido en discount)
  seniorDiscount    Decimal    @default(0) @db.Decimal(12, 2)
  promotionId       String?
  // Extras cobrados en el renglón (incluidos en unitPrice): [{ id, name, price }]
  modifiers         Json?
  promotion         Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  saleId            String
  sale              Sale       @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId         String
  product           Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  returnItems SaleReturnItem[]
  ingredients SaleItemIngredient[]

  @@index([saleId])
  @@index([productId])
}

/**
 * Forma de pago de una venta. Una venta puede tener varias (pago dividido); la suma de los
 * montos es el total de la venta. En efectivo, el monto es lo aplicado (sin el cambio).
 */
model SalePayment {
  id            String        @id @default(cuid())
  method        PaymentMethod
  amount        Decimal       @db.Decimal(12, 2)
  // Número de operación (tarjeta, transferencia, Yappy) o vale enmascarado
  reference     String?
  giftCardId    String?
  yappyChargeId String?
  saleId        String
  sale          Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())

  @@index([saleId])
  @@index([method])
}

/**
 * Insumos que se descontaron al vender un plato con receta (para revertirlos al
 * cancelar o devolver y para saber cuánto se consume de cada insumo).
 */
model SaleItemIngredient {
  id           String   @id @default(cuid())
  // Cantidad total descontada para la cantidad vendida del renglón
  quantity     Decimal  @db.Decimal(12, 3)
  unitCost     Decimal  @db.Decimal(12, 4)
  saleItemId   String
  saleItem     SaleItem @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Product  @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@index([saleItemId])
  @@index([ingredientId])
}

/**
 * Receta de un plato: cuánto de cada insumo lleva (en la unidad del insumo).
 */
model RecipeItem {
  id           String   @id @default(cuid())
  quantity     Decimal  @db.Decimal(12, 4)
  productId    String
  product      Product  @relation("RecipeDish", fields: [productId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Product  @relation("RecipeIngredient", fields: [ingredientId], references: [id], onDelete: Restrict)
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([productId, ingredientId])
  @@index([ingredientId])
  @@index([businessId])
}

model SaleReturn {
  id            String        @id @default(cuid())
  reason        String?
  total         Decimal       @db.Decimal(12, 2)
  costTotal     Decimal       @db.Decimal(12, 2)
  refundMethod  PaymentMethod
  saleId        String
  sale          Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  cashSessionId String?
  cashSession   CashSession?  @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  userId        String?
  businessId    String
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())

  items SaleReturnItem[]

  @@index([businessId, createdAt])
  @@index([saleId])
}

model SaleReturnItem {
  id         String     @id @default(cuid())
  quantity   Decimal    @db.Decimal(12, 3)
  amount     Decimal    @db.Decimal(12, 2)
  cost       Decimal    @db.Decimal(12, 2)
  returnId   String
  return     SaleReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItemId String
  saleItem   SaleItem   @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  productId  String
  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([returnId])
}

model Purchase {
  id              String         @id @default(cuid())
  folio           Int
  status          DocStatus      @default(ACTIVE)
  total           Decimal        @db.Decimal(12, 2)
  // Nombre libre del proveedor cuando no se usa el catálogo
  supplierName    String?
  notes           String?
  paidFromCash    Boolean        @default(false)
  // Comprada a crédito: genera una cuenta por pagar
  onCredit        Boolean        @default(false)
  // ITBMS/IVA incluido en el total (crédito fiscal)
  tax             Decimal        @default(0) @db.Decimal(12, 2)
  bill            SupplierBill?
  // Orden de compra que se recibió con esta compra
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  supplierId      String?
  supplier        Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  cashSessionId   String?
  cashSession     CashSession?   @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  userId          String?
  cancelledAt     DateTime?
  cancelReason    String?
  businessId      String
  business        Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  items PurchaseItem[]

  @@unique([businessId, folio])
  @@index([businessId, createdAt])
  @@index([businessId, status, createdAt])
  @@index([supplierId])
}

model PurchaseItem {
  id         String         @id @default(cuid())
  quantity   Decimal        @db.Decimal(12, 3)
  unitCost   Decimal        @db.Decimal(12, 4)
  subtotal   Decimal        @db.Decimal(12, 2)
  lotCode    String?
  expiresAt  DateTime?
  purchaseId String
  purchase   Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  batches    ProductBatch[]

  @@index([purchaseId])
  @@index([productId])
}

model ProductBatch {
  id             String        @id @default(cuid())
  lotCode        String?
  expiresAt      DateTime?
  quantity       Decimal       @db.Decimal(12, 3)
  remaining      Decimal       @db.Decimal(12, 3)
  productId      String
  product        Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchaseItemId String?
  purchaseItem   PurchaseItem? @relation(fields: [purchaseItemId], references: [id], onDelete: SetNull)
  businessId     String
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@index([productId, expiresAt])
  @@index([businessId, expiresAt])
}

model StockMovement {
  id          String            @id @default(cuid())
  type        StockMovementType
  // Cantidad con signo: positiva entra, negativa sale
  quantity    Decimal           @db.Decimal(12, 3)
  stockAfter  Decimal           @db.Decimal(12, 3)
  unitCost    Decimal?          @db.Decimal(12, 4)
  reason      AdjustmentReason?
  notes       String?
  referenceId String?
  userId      String?
  productId   String
  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  businessId  String
  business    Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())

  @@index([productId, createdAt])
  @@index([businessId, createdAt])
}

model CashSession {
  id             String    @id @default(cuid())
  openingAmount  Decimal   @db.Decimal(12, 2)
  expectedAmount Decimal?  @db.Decimal(12, 2)
  countedAmount  Decimal?  @db.Decimal(12, 2)
  difference     Decimal?  @db.Decimal(12, 2)
  // Conteo por denominación: { "100": 2, "0.25": 12, ... }
  countBreakdown Json?
  notes          String?
  openedById     String
  closedById     String?
  openedAt       DateTime  @default(now())
  closedAt       DateTime?
  businessId     String
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  sales            Sale[]
  returns          SaleReturn[]
  purchases        Purchase[]
  movements        CashMovement[]
  expenses         Expense[]
  customerPayments CustomerPayment[]
  serviceSales     ServiceSale[]
  supplierPayments SupplierPayment[]

  @@index([businessId, closedAt])
  @@index([businessId, openedAt])
}

model CashMovement {
  id            String           @id @default(cuid())
  type          CashMovementType
  amount        Decimal          @db.Decimal(12, 2)
  reason        String
  // Movimiento generado por el sistema (cancelaciones, anulaciones, dueño); vacío = registrado a mano
  source        String?
  cashSessionId String
  cashSession   CashSession      @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)
  userId        String?
  businessId    String
  business      Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt     DateTime         @default(now())

  @@index([cashSessionId])
}

model Expense {
  id            String            @id @default(cuid())
  // Gasto generado al pagar una planilla (sueldos y cuotas patronales)
  payrollRunId  String?           @unique
  payrollRun    PayrollRun?       @relation(fields: [payrollRunId], references: [id], onDelete: SetNull)
  // Gasto generado por un gasto recurrente (renta, luz, internet)
  recurringId   String?
  recurring     RecurringExpense? @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  category      String
  description   String?
  amount        Decimal           @db.Decimal(12, 2)
  paymentMethod PaymentMethod     @default(CASH)
  date          DateTime          @default(now())
  cashSessionId String?
  cashSession   CashSession?      @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  userId        String?
  businessId    String
  business      Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt     DateTime          @default(now())

  @@index([businessId, date])
}

model Invoice {
  id            String        @id @default(cuid())
  kind          InvoiceKind
  status        InvoiceStatus @default(PENDING)
  provider      String
  providerId    String?
  uuid          String?
  total         Decimal       @db.Decimal(12, 2)
  periodicity   String?
  periodStart   DateTime?
  periodEnd     DateTime?
  error         String?
  // Enlaces del PAC (consulta del CUFE / QR, PDF, XML) y reintentos por contingencia
  qrUrl         String?
  pdfUrl        String?
  xmlUrl        String?
  attempts      Int           @default(0)
  nextAttemptAt DateTime?
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  businessId    String
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  sales Sale[]

  @@index([businessId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entity     String
  entityId   String?
  details    Json?
  userId     String?
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
}

enum YappyChargeStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELLED
}

/**
 * Cobro de Yappy iniciado desde el punto de venta (confirmación automática).
 */
model YappyCharge {
  id           String            @id @default(cuid())
  orderId      String            @unique
  amount       Decimal           @db.Decimal(12, 2)
  phone        String?
  status       YappyChargeStatus @default(PENDING)
  provider     String
  providerTxId String?
  error        String?
  saleId       String?           @unique
  sale         Sale?             @relation(fields: [saleId], references: [id], onDelete: SetNull)
  userId       String?
  businessId   String
  business     Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  paidAt       DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([businessId, createdAt])
}

enum PromotionType {
  PERCENT
  BUY_X_PAY_Y
  BUNDLE_PRICE
}

/**
 * Promoción aplicada automáticamente al vender (por producto o categoría).
 */
model Promotion {
  id          String        @id @default(cuid())
  name        String
  type        PromotionType
  // PERCENT: porcentaje (0.10 = 10%)
  percent     Decimal?      @db.Decimal(5, 4)
  // BUY_X_PAY_Y: lleva X paga Y (p. ej. 2x1: buyQty 2, payQty 1)
  buyQty      Int?
  payQty      Int?
  // BUNDLE_PRICE: bundleQty unidades por bundlePrice (p. ej. 3 por B/.1.00)
  bundleQty   Int?
  bundlePrice Decimal?      @db.Decimal(12, 2)
  productId   String?
  product     Product?      @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category?     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  startsAt    DateTime?
  endsAt      DateTime?
  active      Boolean       @default(true)
  businessId  String
  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  saleItems SaleItem[]

  @@index([businessId, active])
}

enum InventoryCountStatus {
  OPEN
  APPLIED
  CANCELLED
}

/**
 * Conteo físico de inventario (se escanea y al final se ajustan las diferencias).
 */
model InventoryCount {
  id         String               @id @default(cuid())
  status     InventoryCountStatus @default(OPEN)
  notes      String?
  userId     String?
  businessId String
  business   Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime             @default(now())
  appliedAt  DateTime?

  lines InventoryCountLine[]

  @@index([businessId, status])
}

model InventoryCountLine {
  id        String         @id @default(cuid())
  counted   Decimal        @db.Decimal(12, 3)
  countId   String
  count     InventoryCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  productId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  updatedAt DateTime       @updatedAt

  @@unique([countId, productId])
}

/**
 * Reportes de traducciones incorrectas o faltantes enviados desde la app.
 */
model TranslationFeedback {
  id         String   @id @default(cuid())
  language   String
  screen     String
  original   String
  suggestion String
  userId     String
  businessId String?
  createdAt  DateTime @default(now())

  @@index([language, createdAt])
}

/**
 * Lo que muestra la pantalla para el cliente de cada cajero (se sincroniza desde el punto de venta).
 */
model CustomerDisplay {
  id         String   @id @default(cuid())
  state      Json
  userId     String
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  updatedAt  DateTime @updatedAt

  @@unique([businessId, userId])
  @@index([businessId, updatedAt])
}

enum OnlineOrderStatus {
  NEW
  ACCEPTED
  READY
  DELIVERED
  CANCELLED
}

/**
 * Pedido hecho desde el catálogo público. Se cobra en el punto de venta y queda enlazado a la venta.
 */
model OnlineOrder {
  id           String            @id @default(cuid())
  number       Int
  status       OnlineOrderStatus @default(NEW)
  customerName String
  phone        String?
  notes        String?
  // PICKUP (recoge en tienda) o DELIVERY (a domicilio)
  fulfillment  String            @default("PICKUP")
  address      String?
  deliveryZone String?
  deliveryFee  Decimal           @default(0) @db.Decimal(12, 2)
  // [{ productId, name, unit, quantity, price }] con el precio al momento del pedido
  items        Json
  total        Decimal           @db.Decimal(12, 2)
  saleId       String?           @unique
  sale         Sale?             @relation(fields: [saleId], references: [id], onDelete: SetNull)
  businessId   String
  business     Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([businessId, number])
  @@index([businessId, status, createdAt])
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIAL
  RECEIVED
  CANCELLED
}

/**
 * Pedido formal al proveedor. Al recibir la mercancía se registra una compra por lo que llegó.
 */
model PurchaseOrder {
  id           String              @id @default(cuid())
  folio        Int
  status       PurchaseOrderStatus @default(DRAFT)
  supplierId   String?
  supplier     Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierName String?
  notes        String?
  expectedAt   DateTime?
  // Total estimado con el costo pedido
  total        Decimal             @db.Decimal(12, 2)
  userId       String?
  sentAt       DateTime?
  businessId   String
  business     Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  lines     PurchaseOrderLine[]
  purchases Purchase[]

  @@unique([businessId, folio])
  @@index([businessId, status, createdAt])
}

model PurchaseOrderLine {
  id               String        @id @default(cuid())
  quantity         Decimal       @db.Decimal(12, 3)
  receivedQuantity Decimal       @default(0) @db.Decimal(12, 3)
  unitCost         Decimal       @db.Decimal(12, 4)
  orderId          String
  order            PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

enum StockTransferStatus {
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

/**
 * Traspaso de mercancía entre sucursales del mismo dueño: sale del origen al enviarse
 * y entra al destino al recibirse.
 */
model StockTransfer {
  id             String              @id @default(cuid())
  status         StockTransferStatus @default(IN_TRANSIT)
  notes          String?
  fromBusinessId String
  fromBusiness   Business            @relation("TransferFrom", fields: [fromBusinessId], references: [id], onDelete: Cascade)
  toBusinessId   String
  toBusiness     Business            @relation("TransferTo", fields: [toBusinessId], references: [id], onDelete: Cascade)
  createdById    String
  receivedById   String?
  createdAt      DateTime            @default(now())
  receivedAt     DateTime?

  lines StockTransferLine[]

  @@index([fromBusinessId, createdAt])
  @@index([toBusinessId, status])
}

model StockTransferLine {
  id            String        @id @default(cuid())
  transferId    String
  transfer      StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  // Producto en la sucursal de origen y copia de sus datos para encontrarlo o crearlo en el destino
  productId     String
  name          String
  barcode       String?
  sku           String?
  unit          ProductUnit
  quantity      Decimal       @db.Decimal(12, 3)
  unitCost      Decimal       @db.Decimal(12, 4)
  price         Decimal       @db.Decimal(12, 2)
  taxRate       Decimal       @db.Decimal(5, 4)
  destProductId String?

  @@index([transferId])
}

/**
 * Recarga o pago de servicio cobrado en la tienda y procesado en la terminal del proveedor.
 * El monto se le debe al proveedor (no es venta); la comisión es ingreso del negocio.
 */
model ServiceSale {
  id            String        @id @default(cuid())
  // RECHARGE (recarga celular), BILL (luz, agua, internet) u OTHER
  kind          String
  provider      String
  reference     String?
  amount        Decimal       @db.Decimal(12, 2)
  commission    Decimal       @default(0) @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  status        DocStatus     @default(ACTIVE)
  cancelledAt   DateTime?
  cashSessionId String?
  cashSession   CashSession?  @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  userId        String?
  businessId    String
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())

  @@index([businessId, createdAt])
  @@index([cashSessionId])
}

enum GiftCardStatus {
  ACTIVE
  VOID
}

/**
 * Vale o tarjeta de regalo. Al emitirlo el dinero recibido es un pasivo (no venta);
 * la venta se reconoce cuando se paga con el vale.
 */
model GiftCard {
  id            String         @id @default(cuid())
  code          String
  initialAmount Decimal        @db.Decimal(12, 2)
  balance       Decimal        @db.Decimal(12, 2)
  status        GiftCardStatus @default(ACTIVE)
  customerName  String?
  expiresAt     DateTime?
  issuedById    String?
  businessId    String
  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  sales        Sale[]
  transactions GiftCardTransaction[]

  @@unique([businessId, code])
  @@index([businessId, createdAt])
}

model GiftCardTransaction {
  id            String         @id @default(cuid())
  // ISSUE (emisión), REDEEM (pago), REFUND (devolución/cancelación) o VOID (anulación)
  type          String
  // Con signo: positivo aumenta el saldo del vale
  amount        Decimal        @db.Decimal(12, 2)
  // Forma en que se pagó la emisión
  paymentMethod PaymentMethod?
  saleId        String?
  cashSessionId String?
  giftCardId    String
  giftCard      GiftCard       @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  userId        String?
  businessId    String
  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())

  @@index([giftCardId, createdAt])
  @@index([cashSessionId])
}

enum OpenOrderStatus {
  OPEN
  CLOSED
  CANCELLED
}

/**
 * Cuenta abierta (mesa, para llevar): se agregan productos y se cobra al final.
 */
model OpenOrder {
  id         String          @id @default(cuid())
  number     Int
  label      String
  status     OpenOrderStatus @default(OPEN)
  notes      String?
  userId     String?
  saleId     String?         @unique
  sale       Sale?           @relation(fields: [saleId], references: [id], onDelete: SetNull)
  businessId String
  business   Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  items OpenOrderItem[]

  @@unique([businessId, number])
  @@index([businessId, status])
}

model OpenOrderItem {
  id            String    @id @default(cuid())
  quantity      Decimal   @db.Decimal(12, 3)
  // Extras elegidos: [{ id, name, price }]
  modifiers     Json?
  notes         String?
  // Copia de product.sendToKitchen al agregarse
  sendToKitchen Boolean   @default(false)
  // PENDING, PREPARING, READY o SERVED
  kitchenStatus String    @default("PENDING")
  orderId       String
  order         OpenOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([orderId])
}

model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}

enum BusinessStatus {
  ACTIVE
  TRIAL
  SUSPENDED
  // Registro esperando la aprobación del super admin (si la exige)
  PENDING
  // Dado de baja: no se puede usar, los datos se conservan y se puede reactivar
  CLOSED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

/**
 * Plan de suscripción: precio, límites y funciones incluidas.
 */
model Plan {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  description  String?
  priceMonthly Decimal  @db.Decimal(10, 2)
  priceYearly  Decimal? @db.Decimal(10, 2)
  currency     String   @default("USD")
  trialDays    Int      @default(14)
  // Límites (vacío = sin límite)
  maxUsers     Int?
  maxBranches  Int?
  maxProducts  Int?
  // Claves de funciones incluidas (ver src/lib/features.ts)
  features     String[]
  active       Boolean  @default(true)
  // Plan que reciben los negocios nuevos al registrarse
  isDefault    Boolean  @default(false)
  // Se muestra en la página de precios
  isPublic     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  businesses Business[]
  payments   SubscriptionPayment[]
  charges    SubscriptionCharge[]
}

/**
 * Pago de la suscripción de un negocio (registrado por el super admin).
 */
model SubscriptionPayment {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  planId      String?
  plan        Plan?    @relation(fields: [planId], references: [id], onDelete: SetNull)
  amount      Decimal  @db.Decimal(10, 2)
  currency    String   @default("USD")
  method      String
  reference   String?
  periodStart DateTime
  periodEnd   DateTime
  notes       String?
  createdById String
  createdAt   DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([createdAt])
}

/**
 * Bitácora de las acciones del super admin sobre la plataforma.
 */
model AdminAuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  details   Json?
  userId    String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

enum SupplierBillStatus {
  OPEN
  PAID
  CANCELLED
}

/**
 * Cuenta por pagar: factura de un proveedor comprada a crédito (o registrada a mano).
 * El saldo baja con cada abono.
 */
model SupplierBill {
  id           String             @id @default(cuid())
  // Número de factura del proveedor
  number       String?
  status       SupplierBillStatus @default(OPEN)
  supplierId   String?
  supplier     Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierName String?
  purchaseId   String?            @unique
  purchase     Purchase?          @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  // Fecha de la factura y vencimiento (día calendario)
  date         DateTime
  dueDate      DateTime
  total        Decimal            @db.Decimal(12, 2)
  // ITBMS/IVA incluido en el total (crédito fiscal)
  tax          Decimal            @default(0) @db.Decimal(12, 2)
  balance      Decimal            @db.Decimal(12, 2)
  notes        String?
  cancelledAt  DateTime?
  userId       String?
  businessId   String
  business     Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  payments SupplierPayment[]

  @@index([businessId, status, dueDate])
  @@index([supplierId])
}

/**
 * Abono a una factura de proveedor. En efectivo sale de la caja abierta; si no, del banco.
 */
model SupplierPayment {
  id            String        @id @default(cuid())
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  // true = salió del efectivo de la caja (entra al corte)
  fromCash      Boolean       @default(false)
  reference     String?
  notes         String?
  voidedAt      DateTime?
  billId        String
  bill          SupplierBill  @relation(fields: [billId], references: [id], onDelete: Cascade)
  cashSessionId String?
  cashSession   CashSession?  @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  userId        String?
  businessId    String
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())

  @@index([billId])
  @@index([businessId, createdAt])
  @@index([cashSessionId])
}

/**
 * Gasto fijo que se repite cada mes (renta, luz, internet). El cron diario registra el gasto
 * del mes al llegar su día; también alimenta el flujo de caja y el punto de equilibrio.
 */
model RecurringExpense {
  id            String        @id @default(cuid())
  category      String
  description   String?
  amount        Decimal       @db.Decimal(12, 2)
  // Día del mes en que se paga (29-31 caen el último día en meses más cortos)
  dayOfMonth    Int
  paymentMethod PaymentMethod @default(TRANSFER)
  active        Boolean       @default(true)
  // Último mes "YYYY-MM" en que se registró el gasto
  lastGenerated String?
  userId        String?
  businessId    String
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  expenses Expense[]

  @@index([businessId, active])
}

enum OwnerTransactionType {
  CONTRIBUTION
  WITHDRAWAL
}

/**
 * Aporte o retiro del dueño: separa el dinero personal del negocio. En efectivo entra o sale
 * de la caja abierta.
 */
model OwnerTransaction {
  id            String               @id @default(cuid())
  type          OwnerTransactionType
  amount        Decimal              @db.Decimal(12, 2)
  method        PaymentMethod
  date          DateTime
  notes         String?
  cashSessionId String?
  userId        String?
  businessId    String
  business      Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt     DateTime             @default(now())

  @@index([businessId, date])
}

/**
 * Mes contable cerrado: no se registran, cancelan ni editan ventas, compras ni gastos con
 * fecha en ese mes. El dueño puede reabrirlo y queda en la bitácora.
 */
model AccountingPeriod {
  id         String    @id @default(cuid())
  // "YYYY-MM"
  month      String
  closedAt   DateTime?
  closedById String?
  reopenedAt DateTime?
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([businessId, month])
}

enum PayFrequency {
  QUINCENAL
  MENSUAL
}

enum PayrollStatus {
  DRAFT
  PAID
}

/**
 * Empleado del negocio: salario mensual, forma de pago y datos para la CSS.
 */
model Employee {
  id                   String       @id @default(cuid())
  name                 String
  // Cédula y número de seguro social
  idNumber             String?
  socialSecurityNumber String?
  position             String?
  // Salario mensual (en planilla quincenal se paga la mitad cada quincena)
  salary               Decimal      @db.Decimal(12, 2)
  frequency            PayFrequency @default(QUINCENAL)
  hireDate             DateTime
  // Última vez que tomó vacaciones (para las acumuladas); vacío = desde que entró
  vacationSince        DateTime?
  active               Boolean      @default(true)
  terminatedAt         DateTime?
  businessId           String
  business             Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  lines    PayrollLine[]
  advances SalaryAdvance[]

  @@index([businessId, active])
}

/**
 * Planilla de un periodo (quincena o mes). En borrador se puede ajustar; al pagarse genera
 * el gasto y los asientos contables.
 */
model PayrollRun {
  id                  String         @id @default(cuid())
  frequency           PayFrequency
  // Días calendario "YYYY-MM-DD"
  periodStart         String
  periodEnd           String
  status              PayrollStatus  @default(DRAFT)
  paidAt              DateTime?
  paidMethod          PaymentMethod?
  // Cuotas a la CSS e ISR retenido pagados (se pagan el mes siguiente)
  contributionsPaidAt DateTime?
  gross               Decimal        @default(0) @db.Decimal(12, 2)
  deductions          Decimal        @default(0) @db.Decimal(12, 2)
  net                 Decimal        @default(0) @db.Decimal(12, 2)
  employerCost        Decimal        @default(0) @db.Decimal(12, 2)
  userId              String?
  businessId          String
  business            Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  lines    PayrollLine[]
  advances SalaryAdvance[]
  expense  Expense?

  @@unique([businessId, frequency, periodStart])
  @@index([businessId, periodEnd])
}

model PayrollLine {
  id             String     @id @default(cuid())
  runId          String
  run            PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  salary         Decimal    @db.Decimal(12, 2)
  overtimeHours  Decimal    @default(0) @db.Decimal(8, 2)
  overtime       Decimal    @default(0) @db.Decimal(12, 2)
  // Partida del décimo tercer mes pagada en esta planilla
  thirteenth     Decimal    @default(0) @db.Decimal(12, 2)
  gross          Decimal    @db.Decimal(12, 2)
  cssEmployee    Decimal    @db.Decimal(12, 2)
  eduEmployee    Decimal    @db.Decimal(12, 2)
  incomeTax      Decimal    @db.Decimal(12, 2)
  advances       Decimal    @default(0) @db.Decimal(12, 2)
  otherDeduction Decimal    @default(0) @db.Decimal(12, 2)
  net            Decimal    @db.Decimal(12, 2)
  cssEmployer    Decimal    @db.Decimal(12, 2)
  eduEmployer    Decimal    @db.Decimal(12, 2)
  riskEmployer   Decimal    @db.Decimal(12, 2)

  @@unique([runId, employeeId])
}

/**
 * Adelanto de sueldo: se entrega ahora y se descuenta en la siguiente planilla.
 */
model SalaryAdvance {
  id            String        @id @default(cuid())
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  date          DateTime
  notes         String?
  employeeId    String
  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  // Planilla en la que se descontó
  runId         String?
  run           PayrollRun?   @relation(fields: [runId], references: [id], onDelete: SetNull)
  cashSessionId String?
  userId        String?
  businessId    String
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())

  @@index([employeeId, runId])
}

enum CouponKind {
  PERCENT
  AMOUNT
}

/**
 * Cupón de descuento que se escribe o escanea en el punto de venta.
 */
model Coupon {
  id          String     @id @default(cuid())
  code        String
  kind        CouponKind
  // PERCENT: fracción (0.10 = 10%); AMOUNT: monto fijo
  value       Decimal    @db.Decimal(12, 4)
  minPurchase Decimal?   @db.Decimal(12, 2)
  startsAt    DateTime?
  endsAt      DateTime?
  // Usos permitidos (vacío = sin límite) y usados
  maxUses     Int?
  uses        Int        @default(0)
  active      Boolean    @default(true)
  businessId  String
  business    Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  sales     Sale[]
  campaigns Campaign[]

  @@unique([businessId, code])
}

enum CampaignStatus {
  DRAFT
  SENT
}

/**
 * Campaña por WhatsApp a un segmento de clientes que aceptaron recibir promociones.
 */
model Campaign {
  id         String         @id @default(cuid())
  name       String
  // Plantilla con {nombre}, {puntos} y {cupón}
  message    String
  // { type: "BIRTHDAY" | "INACTIVE" | "FREQUENT" | "OVERDUE" | "TAG" | "ALL", days?, visits?, tag? }
  segment    Json
  couponId   String?
  coupon     Coupon?        @relation(fields: [couponId], references: [id], onDelete: SetNull)
  status     CampaignStatus @default(DRAFT)
  sentAt     DateTime?
  userId     String?
  businessId String
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())

  recipients CampaignRecipient[]

  @@index([businessId, createdAt])
}

enum RecipientStatus {
  PENDING
  SENT
  FAILED
}

model CampaignRecipient {
  id         String          @id @default(cuid())
  campaignId String
  campaign   Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  phone      String
  // Mensaje ya personalizado
  message    String
  status     RecipientStatus @default(PENDING)
  sentAt     DateTime?
  error      String?

  @@unique([campaignId, customerId])
}

enum SubscriptionChargeKind {
  CHECKOUT
  RENEWAL
}

enum SubscriptionChargeStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

/**
 * Intento de cobro en línea de la suscripción: pago del dueño (checkout) o renovación automática
 * con la tarjeta guardada. Al confirmarse registra un SubscriptionPayment.
 */
model SubscriptionCharge {
  id           String                   @id @default(cuid())
  businessId   String
  business     Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  planId       String?
  plan         Plan?                    @relation(fields: [planId], references: [id], onDelete: SetNull)
  kind         SubscriptionChargeKind
  status       SubscriptionChargeStatus @default(PENDING)
  // stripe o simulado
  provider     String
  amount       Decimal                  @db.Decimal(10, 2)
  currency     String                   @default("USD")
  months       Int
  billingCycle BillingCycle
  // Id en el proveedor (sesión de checkout o intento de pago)
  externalId   String?                  @unique
  error        String?
  paymentId    String?                  @unique
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([businessId, createdAt])
  @@index([status, createdAt])
}

/**
 * Reglas del cobro automático (una sola fila, las edita el super admin).
 */
model PlatformSettings {
  id                    String   @id @default("platform")
  // Días después del vencimiento antes de suspender
  graceDays             Int      @default(7)
  // Días entre reintentos y cuántos intentos se hacen
  retryIntervalDays     Int      @default(2)
  maxRetries            Int      @default(3)
  // Días de anticipación de los avisos por correo (antes de cobrar y antes de suspender)
  noticeDays            Int      @default(3)
  // También suspender a quien paga a mano (transferencia) al pasar la gracia
  suspendManualPayers   Boolean  @default(false)
  // Los registros nuevos esperan la aprobación del super admin antes de usarse
  requireSignupApproval Boolean  @default(false)
  updatedAt             DateTime @updatedAt
}

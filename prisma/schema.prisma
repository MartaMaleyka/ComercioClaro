generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// Convenciones:
// - Montos de dinero: Decimal(12,2). Costos unitarios: Decimal(12,4).
// - Cantidades y existencias: Decimal(12,3) para permitir venta a granel (kg, l).

enum Role {
  OWNER
  CASHIER
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  CREDIT
  YAPPY
  GIFT_CARD
}

enum DocStatus {
  ACTIVE
  CANCELLED
}

enum ProductUnit {
  PIECE
  KG
  G
  L
  ML
  M
}

enum StockMovementType {
  INITIAL
  SALE
  SALE_CANCEL
  SALE_RETURN
  PURCHASE
  PURCHASE_CANCEL
  ADJUSTMENT
  TRANSFER_OUT
  TRANSFER_IN
}

enum AdjustmentReason {
  COUNT
  WASTE
  EXPIRED
  THEFT
  DAMAGED
  OTHER
}

enum CashMovementType {
  IN
  OUT
}

enum InvoiceKind {
  INDIVIDUAL
  GLOBAL
}

enum InvoiceStatus {
  PENDING
  STAMPED
  CANCELLED
  ERROR
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  name               String
  // Se incrementa al cambiar contraseña o cerrar todas las sesiones para invalidar JWT emitidos.
  tokenVersion       Int       @default(0)
  mustChangePassword Boolean   @default(false)
  // Idioma de la interfaz: es, zh, en
  language           String    @default("es")
  resetTokenHash     String?   @unique
  resetExpires       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  memberships Membership[]
}

model Membership {
  id         String   @id @default(cuid())
  role       Role     @default(OWNER)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, businessId])
  @@index([businessId])
}

model Business {
  id                   String   @id @default(cuid())
  name                 String
  description          String?
  phone                String?
  address              String?
  // País (ISO 3166-1): define impuestos, facturación y formatos por defecto
  country              String   @default("MX")
  currency             String   @default("MXN")
  // Panamá: mostrar montos como B/. (balboa a la par del dólar)
  showBalboa           Boolean  @default(false)
  locale               String   @default("es-MX")
  timezone             String   @default("America/Mexico_City")
  lowStockEmailAlerts  Boolean  @default(false)
  // Datos fiscales Panamá
  ruc                  String?
  dv                   String?
  // Usa el facturador gratuito de la DGI (se vigilan sus límites)
  usesFreeInvoicer     Boolean  @default(false)
  // Yappy: número o nombre en el directorio y QR estático (data URL)
  yappyDirectory       String?
  yappyQr              String?
  // Comisiones por medio de pago (fracción, p. ej. 0.0107 = 1.07%)
  cardFeeRate          Decimal  @default(0) @db.Decimal(6, 4)
  transferFeeRate      Decimal  @default(0) @db.Decimal(6, 4)
  yappyFeeRate         Decimal  @default(0.0107) @db.Decimal(6, 4)
  // Yappy: STATIC (QR fijo del comercio) o API (cobro con confirmación automática)
  yappyMode            String   @default("STATIC")
  // Factura electrónica: OFF, MANUAL (se registra el CUFE) o PAC (emisión automática)
  einvoiceMode         String   @default("MANUAL")
  einvoiceProvider     String?
  // Emitir la factura de cada venta automáticamente (modo PAC)
  autoInvoice          Boolean  @default(false)
  // Contar cada venta como documento para los límites del facturador gratuito
  invoicePerSale       Boolean  @default(false)
  // Programa de lealtad
  loyaltyEnabled       Boolean  @default(false)
  loyaltyPointsPerUnit Decimal  @default(1) @db.Decimal(8, 2)
  loyaltyPointValue    Decimal  @default(0.01) @db.Decimal(8, 4)
  // Catálogo público con pedidos por WhatsApp
  catalogEnabled       Boolean  @default(false)
  catalogSlug          String?  @unique
  catalogWhatsapp      String?
  // Recargas y pagos de servicios que se cobran: [{ name, kind, commissionRate }]
  serviceProviders     Json?
  // Datos fiscales (CFDI 4.0)
  rfc                  String?
  legalName            String?
  taxRegime            String?
  postalCode           String?
  // Contadores para folios consecutivos por negocio
  saleCounter          Int      @default(0)
  purchaseCounter      Int      @default(0)
  orderCounter         Int      @default(0)
  purchaseOrderCounter Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  memberships      Membership[]
  categories       Category[]
  products         Product[]
  customers        Customer[]
  customerPayments CustomerPayment[]
  suppliers        Supplier[]
  sales            Sale[]
  saleReturns      SaleReturn[]
  purchases        Purchase[]
  batches          ProductBatch[]
  stockMovements   StockMovement[]
  cashSessions     CashSession[]
  cashMovements    CashMovement[]
  expenses         Expense[]
  invoices         Invoice[]
  auditLogs        AuditLog[]
  yappyCharges     YappyCharge[]
  promotions       Promotion[]
  inventoryCounts  InventoryCount[]
  customerDisplays CustomerDisplay[]
  onlineOrders     OnlineOrder[]
  purchaseOrders   PurchaseOrder[]
  transfersOut     StockTransfer[]       @relation("TransferFrom")
  transfersIn      StockTransfer[]       @relation("TransferTo")
  serviceSales     ServiceSale[]
  giftCards        GiftCard[]
  giftCardMoves    GiftCardTransaction[]
}

model Category {
  id         String      @id @default(cuid())
  name       String
  businessId String
  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products   Product[]
  promotions Promotion[]

  @@unique([businessId, name])
}

model Product {
  id              String      @id @default(cuid())
  name            String
  description     String?
  sku             String?
  barcode         String?
  unit            ProductUnit @default(PIECE)
  price           Decimal     @db.Decimal(12, 2)
  wholesalePrice  Decimal?    @db.Decimal(12, 2)
  wholesaleMinQty Decimal?    @db.Decimal(12, 3)
  // Costo promedio ponderado
  cost            Decimal     @default(0) @db.Decimal(12, 4)
  stock           Decimal     @default(0) @db.Decimal(12, 3)
  minStock        Decimal     @default(5) @db.Decimal(12, 3)
  trackExpiry     Boolean     @default(false)
  // Unidades por caja/paquete al comprar (venta suelta)
  packSize        Int?
  // Impuestos (los precios incluyen impuestos)
  taxRate         Decimal     @default(0.16) @db.Decimal(5, 4)
  iepsRate        Decimal     @default(0) @db.Decimal(5, 4)
  satProductKey   String      @default("01010101")
  satUnitKey      String      @default("H87")
  categoryId      String?
  category        Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  businessId      String
  business        Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  archivedAt      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  saleItems      SaleItem[]
  purchaseItems  PurchaseItem[]
  returnItems    SaleReturnItem[]
  batches        ProductBatch[]
  stockMovements StockMovement[]
  promotions     Promotion[]
  countLines     InventoryCountLine[]
  orderLines     PurchaseOrderLine[]

  @@unique([businessId, barcode])
  @@index([businessId, archivedAt, name])
  @@index([categoryId])
}

model Customer {
  id          String    @id @default(cuid())
  name        String
  phone       String?
  email       String?
  notes       String?
  creditLimit Decimal   @default(0) @db.Decimal(12, 2)
  // Días de crédito para calcular el vencimiento del fiado
  creditDays  Int       @default(15)
  // Puntos de lealtad acumulados
  points      Int       @default(0)
  // Saldo pendiente de fiado (se actualiza en la misma transacción que ventas y abonos)
  balance     Decimal   @default(0) @db.Decimal(12, 2)
  rfc         String?
  legalName   String?
  taxRegime   String?
  postalCode  String?
  ruc         String?
  dv          String?
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sales    Sale[]
  payments CustomerPayment[]
  invoices Invoice[]

  @@index([businessId, archivedAt, name])
}

model CustomerPayment {
  id            String        @id @default(cuid())
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  notes         String?
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  businessId    String
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  cashSessionId String?
  cashSession   CashSession?  @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  userId        String?
  createdAt     DateTime      @default(now())

  @@index([customerId, createdAt])
  @@index([businessId, createdAt])
}

model Supplier {
  id         String    @id @default(cuid())
  name       String
  contact    String?
  phone      String?
  email      String?
  notes      String?
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  purchases      Purchase[]
  purchaseOrders PurchaseOrder[]

  @@index([businessId, archivedAt, name])
}

model Sale {
  id               String        @id @default(cuid())
  folio            Int
  // Identificador generado por el cliente para evitar duplicados al sincronizar ventas sin conexión
  clientRequestId  String?
  status           DocStatus     @default(ACTIVE)
  paymentMethod    PaymentMethod @default(CASH)
  subtotal         Decimal       @db.Decimal(12, 2)
  discount         Decimal       @default(0) @db.Decimal(12, 2)
  total            Decimal       @db.Decimal(12, 2)
  // Costo de lo vendido (COGS) calculado con el costo promedio al momento de la venta
  costTotal        Decimal       @default(0) @db.Decimal(12, 2)
  amountReceived   Decimal?      @db.Decimal(12, 2)
  change           Decimal?      @db.Decimal(12, 2)
  // Número de operación (Yappy, transferencia, voucher de tarjeta)
  paymentReference String?
  // Vencimiento del fiado
  dueDate          DateTime?
  // Lealtad: puntos ganados y canjeados en la venta
  pointsEarned     Int           @default(0)
  pointsRedeemed   Int           @default(0)
  pointsDiscount   Decimal       @default(0) @db.Decimal(12, 2)
  yappyCharge      YappyCharge?
  onlineOrder      OnlineOrder?
  // Vale con el que se pagó la venta
  giftCardId       String?
  giftCard         GiftCard?     @relation(fields: [giftCardId], references: [id], onDelete: SetNull)
  notes            String?
  customerId       String?
  customer         Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  cashSessionId    String?
  cashSession      CashSession?  @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  invoiceId        String?
  invoice          Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  userId           String?
  cancelledAt      DateTime?
  cancelReason     String?
  businessId       String
  business         Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  items   SaleItem[]
  returns SaleReturn[]

  @@unique([businessId, folio])
  @@unique([businessId, clientRequestId])
  @@index([businessId, createdAt])
  @@index([businessId, status, createdAt])
  @@index([customerId])
  @@index([cashSessionId])
  @@index([invoiceId])
}

model SaleItem {
  id                String     @id @default(cuid())
  quantity          Decimal    @db.Decimal(12, 3)
  returnedQuantity  Decimal    @default(0) @db.Decimal(12, 3)
  unitPrice         Decimal    @db.Decimal(12, 2)
  discount          Decimal    @default(0) @db.Decimal(12, 2)
  subtotal          Decimal    @db.Decimal(12, 2)
  unitCost          Decimal    @default(0) @db.Decimal(12, 4)
  taxRate           Decimal    @default(0.16) @db.Decimal(5, 4)
  iepsRate          Decimal    @default(0) @db.Decimal(5, 4)
  // Descuento aplicado por una promoción (incluido en discount)
  promotionDiscount Decimal    @default(0) @db.Decimal(12, 2)
  promotionId       String?
  promotion         Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  saleId            String
  sale              Sale       @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId         String
  product           Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  returnItems SaleReturnItem[]

  @@index([saleId])
  @@index([productId])
}

model SaleReturn {
  id            String        @id @default(cuid())
  reason        String?
  total         Decimal       @db.Decimal(12, 2)
  costTotal     Decimal       @db.Decimal(12, 2)
  refundMethod  PaymentMethod
  saleId        String
  sale          Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  cashSessionId String?
  cashSession   CashSession?  @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  userId        String?
  businessId    String
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())

  items SaleReturnItem[]

  @@index([businessId, createdAt])
  @@index([saleId])
}

model SaleReturnItem {
  id         String     @id @default(cuid())
  quantity   Decimal    @db.Decimal(12, 3)
  amount     Decimal    @db.Decimal(12, 2)
  cost       Decimal    @db.Decimal(12, 2)
  returnId   String
  return     SaleReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItemId String
  saleItem   SaleItem   @relation(fields: [saleItemId], references: [id], onDelete: Cascade)
  productId  String
  product    Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([returnId])
}

model Purchase {
  id              String         @id @default(cuid())
  folio           Int
  status          DocStatus      @default(ACTIVE)
  total           Decimal        @db.Decimal(12, 2)
  // Nombre libre del proveedor cuando no se usa el catálogo
  supplierName    String?
  notes           String?
  paidFromCash    Boolean        @default(false)
  // Orden de compra que se recibió con esta compra
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  supplierId      String?
  supplier        Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  cashSessionId   String?
  cashSession     CashSession?   @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  userId          String?
  cancelledAt     DateTime?
  cancelReason    String?
  businessId      String
  business        Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  items PurchaseItem[]

  @@unique([businessId, folio])
  @@index([businessId, createdAt])
  @@index([businessId, status, createdAt])
  @@index([supplierId])
}

model PurchaseItem {
  id         String         @id @default(cuid())
  quantity   Decimal        @db.Decimal(12, 3)
  unitCost   Decimal        @db.Decimal(12, 4)
  subtotal   Decimal        @db.Decimal(12, 2)
  lotCode    String?
  expiresAt  DateTime?
  purchaseId String
  purchase   Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  batches    ProductBatch[]

  @@index([purchaseId])
  @@index([productId])
}

model ProductBatch {
  id             String        @id @default(cuid())
  lotCode        String?
  expiresAt      DateTime?
  quantity       Decimal       @db.Decimal(12, 3)
  remaining      Decimal       @db.Decimal(12, 3)
  productId      String
  product        Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchaseItemId String?
  purchaseItem   PurchaseItem? @relation(fields: [purchaseItemId], references: [id], onDelete: SetNull)
  businessId     String
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@index([productId, expiresAt])
  @@index([businessId, expiresAt])
}

model StockMovement {
  id          String            @id @default(cuid())
  type        StockMovementType
  // Cantidad con signo: positiva entra, negativa sale
  quantity    Decimal           @db.Decimal(12, 3)
  stockAfter  Decimal           @db.Decimal(12, 3)
  unitCost    Decimal?          @db.Decimal(12, 4)
  reason      AdjustmentReason?
  notes       String?
  referenceId String?
  userId      String?
  productId   String
  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  businessId  String
  business    Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())

  @@index([productId, createdAt])
  @@index([businessId, createdAt])
}

model CashSession {
  id             String    @id @default(cuid())
  openingAmount  Decimal   @db.Decimal(12, 2)
  expectedAmount Decimal?  @db.Decimal(12, 2)
  countedAmount  Decimal?  @db.Decimal(12, 2)
  difference     Decimal?  @db.Decimal(12, 2)
  notes          String?
  openedById     String
  closedById     String?
  openedAt       DateTime  @default(now())
  closedAt       DateTime?
  businessId     String
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  sales            Sale[]
  returns          SaleReturn[]
  purchases        Purchase[]
  movements        CashMovement[]
  expenses         Expense[]
  customerPayments CustomerPayment[]
  serviceSales     ServiceSale[]

  @@index([businessId, closedAt])
  @@index([businessId, openedAt])
}

model CashMovement {
  id            String           @id @default(cuid())
  type          CashMovementType
  amount        Decimal          @db.Decimal(12, 2)
  reason        String
  cashSessionId String
  cashSession   CashSession      @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)
  userId        String?
  businessId    String
  business      Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt     DateTime         @default(now())

  @@index([cashSessionId])
}

model Expense {
  id            String        @id @default(cuid())
  category      String
  description   String?
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod @default(CASH)
  date          DateTime      @default(now())
  cashSessionId String?
  cashSession   CashSession?  @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  userId        String?
  businessId    String
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())

  @@index([businessId, date])
}

model Invoice {
  id            String        @id @default(cuid())
  kind          InvoiceKind
  status        InvoiceStatus @default(PENDING)
  provider      String
  providerId    String?
  uuid          String?
  total         Decimal       @db.Decimal(12, 2)
  periodicity   String?
  periodStart   DateTime?
  periodEnd     DateTime?
  error         String?
  // Enlaces del PAC (consulta del CUFE / QR, PDF, XML) y reintentos por contingencia
  qrUrl         String?
  pdfUrl        String?
  xmlUrl        String?
  attempts      Int           @default(0)
  nextAttemptAt DateTime?
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  businessId    String
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  sales Sale[]

  @@index([businessId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entity     String
  entityId   String?
  details    Json?
  userId     String?
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([businessId, createdAt])
}

enum YappyChargeStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELLED
}

/**
 * Cobro de Yappy iniciado desde el punto de venta (confirmación automática).
 */
model YappyCharge {
  id           String            @id @default(cuid())
  orderId      String            @unique
  amount       Decimal           @db.Decimal(12, 2)
  phone        String?
  status       YappyChargeStatus @default(PENDING)
  provider     String
  providerTxId String?
  error        String?
  saleId       String?           @unique
  sale         Sale?             @relation(fields: [saleId], references: [id], onDelete: SetNull)
  userId       String?
  businessId   String
  business     Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  paidAt       DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([businessId, createdAt])
}

enum PromotionType {
  PERCENT
  BUY_X_PAY_Y
  BUNDLE_PRICE
}

/**
 * Promoción aplicada automáticamente al vender (por producto o categoría).
 */
model Promotion {
  id          String        @id @default(cuid())
  name        String
  type        PromotionType
  // PERCENT: porcentaje (0.10 = 10%)
  percent     Decimal?      @db.Decimal(5, 4)
  // BUY_X_PAY_Y: lleva X paga Y (p. ej. 2x1: buyQty 2, payQty 1)
  buyQty      Int?
  payQty      Int?
  // BUNDLE_PRICE: bundleQty unidades por bundlePrice (p. ej. 3 por B/.1.00)
  bundleQty   Int?
  bundlePrice Decimal?      @db.Decimal(12, 2)
  productId   String?
  product     Product?      @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category?     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  startsAt    DateTime?
  endsAt      DateTime?
  active      Boolean       @default(true)
  businessId  String
  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  saleItems SaleItem[]

  @@index([businessId, active])
}

enum InventoryCountStatus {
  OPEN
  APPLIED
  CANCELLED
}

/**
 * Conteo físico de inventario (se escanea y al final se ajustan las diferencias).
 */
model InventoryCount {
  id         String               @id @default(cuid())
  status     InventoryCountStatus @default(OPEN)
  notes      String?
  userId     String?
  businessId String
  business   Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime             @default(now())
  appliedAt  DateTime?

  lines InventoryCountLine[]

  @@index([businessId, status])
}

model InventoryCountLine {
  id        String         @id @default(cuid())
  counted   Decimal        @db.Decimal(12, 3)
  countId   String
  count     InventoryCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  productId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  updatedAt DateTime       @updatedAt

  @@unique([countId, productId])
}

/**
 * Reportes de traducciones incorrectas o faltantes enviados desde la app.
 */
model TranslationFeedback {
  id         String   @id @default(cuid())
  language   String
  screen     String
  original   String
  suggestion String
  userId     String
  businessId String?
  createdAt  DateTime @default(now())

  @@index([language, createdAt])
}

/**
 * Lo que muestra la pantalla para el cliente de cada cajero (se sincroniza desde el punto de venta).
 */
model CustomerDisplay {
  id         String   @id @default(cuid())
  state      Json
  userId     String
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  updatedAt  DateTime @updatedAt

  @@unique([businessId, userId])
  @@index([businessId, updatedAt])
}

enum OnlineOrderStatus {
  NEW
  ACCEPTED
  READY
  DELIVERED
  CANCELLED
}

/**
 * Pedido hecho desde el catálogo público. Se cobra en el punto de venta y queda enlazado a la venta.
 */
model OnlineOrder {
  id           String            @id @default(cuid())
  number       Int
  status       OnlineOrderStatus @default(NEW)
  customerName String
  phone        String?
  notes        String?
  // PICKUP (recoge en tienda) o DELIVERY (a domicilio)
  fulfillment  String            @default("PICKUP")
  address      String?
  // [{ productId, name, unit, quantity, price }] con el precio al momento del pedido
  items        Json
  total        Decimal           @db.Decimal(12, 2)
  saleId       String?           @unique
  sale         Sale?             @relation(fields: [saleId], references: [id], onDelete: SetNull)
  businessId   String
  business     Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([businessId, number])
  @@index([businessId, status, createdAt])
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIAL
  RECEIVED
  CANCELLED
}

/**
 * Pedido formal al proveedor. Al recibir la mercancía se registra una compra por lo que llegó.
 */
model PurchaseOrder {
  id           String              @id @default(cuid())
  folio        Int
  status       PurchaseOrderStatus @default(DRAFT)
  supplierId   String?
  supplier     Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierName String?
  notes        String?
  expectedAt   DateTime?
  // Total estimado con el costo pedido
  total        Decimal             @db.Decimal(12, 2)
  userId       String?
  sentAt       DateTime?
  businessId   String
  business     Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  lines     PurchaseOrderLine[]
  purchases Purchase[]

  @@unique([businessId, folio])
  @@index([businessId, status, createdAt])
}

model PurchaseOrderLine {
  id               String        @id @default(cuid())
  quantity         Decimal       @db.Decimal(12, 3)
  receivedQuantity Decimal       @default(0) @db.Decimal(12, 3)
  unitCost         Decimal       @db.Decimal(12, 4)
  orderId          String
  order            PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String
  product          Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

enum StockTransferStatus {
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

/**
 * Traspaso de mercancía entre sucursales del mismo dueño: sale del origen al enviarse
 * y entra al destino al recibirse.
 */
model StockTransfer {
  id             String              @id @default(cuid())
  status         StockTransferStatus @default(IN_TRANSIT)
  notes          String?
  fromBusinessId String
  fromBusiness   Business            @relation("TransferFrom", fields: [fromBusinessId], references: [id], onDelete: Cascade)
  toBusinessId   String
  toBusiness     Business            @relation("TransferTo", fields: [toBusinessId], references: [id], onDelete: Cascade)
  createdById    String
  receivedById   String?
  createdAt      DateTime            @default(now())
  receivedAt     DateTime?

  lines StockTransferLine[]

  @@index([fromBusinessId, createdAt])
  @@index([toBusinessId, status])
}

model StockTransferLine {
  id            String        @id @default(cuid())
  transferId    String
  transfer      StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  // Producto en la sucursal de origen y copia de sus datos para encontrarlo o crearlo en el destino
  productId     String
  name          String
  barcode       String?
  sku           String?
  unit          ProductUnit
  quantity      Decimal       @db.Decimal(12, 3)
  unitCost      Decimal       @db.Decimal(12, 4)
  price         Decimal       @db.Decimal(12, 2)
  taxRate       Decimal       @db.Decimal(5, 4)
  destProductId String?

  @@index([transferId])
}

/**
 * Recarga o pago de servicio cobrado en la tienda y procesado en la terminal del proveedor.
 * El monto se le debe al proveedor (no es venta); la comisión es ingreso del negocio.
 */
model ServiceSale {
  id            String        @id @default(cuid())
  // RECHARGE (recarga celular), BILL (luz, agua, internet) u OTHER
  kind          String
  provider      String
  reference     String?
  amount        Decimal       @db.Decimal(12, 2)
  commission    Decimal       @default(0) @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  status        DocStatus     @default(ACTIVE)
  cancelledAt   DateTime?
  cashSessionId String?
  cashSession   CashSession?  @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  userId        String?
  businessId    String
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())

  @@index([businessId, createdAt])
  @@index([cashSessionId])
}

enum GiftCardStatus {
  ACTIVE
  VOID
}

/**
 * Vale o tarjeta de regalo. Al emitirlo el dinero recibido es un pasivo (no venta);
 * la venta se reconoce cuando se paga con el vale.
 */
model GiftCard {
  id            String         @id @default(cuid())
  code          String
  initialAmount Decimal        @db.Decimal(12, 2)
  balance       Decimal        @db.Decimal(12, 2)
  status        GiftCardStatus @default(ACTIVE)
  customerName  String?
  expiresAt     DateTime?
  issuedById    String?
  businessId    String
  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  sales        Sale[]
  transactions GiftCardTransaction[]

  @@unique([businessId, code])
  @@index([businessId, createdAt])
}

model GiftCardTransaction {
  id            String         @id @default(cuid())
  // ISSUE (emisión), REDEEM (pago), REFUND (devolución/cancelación) o VOID (anulación)
  type          String
  // Con signo: positivo aumenta el saldo del vale
  amount        Decimal        @db.Decimal(12, 2)
  // Forma en que se pagó la emisión
  paymentMethod PaymentMethod?
  saleId        String?
  cashSessionId String?
  giftCardId    String
  giftCard      GiftCard       @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  userId        String?
  businessId    String
  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())

  @@index([giftCardId, createdAt])
  @@index([cashSessionId])
}

model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}

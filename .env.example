# Copia este archivo a .env y ajusta los valores.

# Base de datos PostgreSQL (docker compose up -d levanta una local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/comercioclaro"
# Base usada por las pruebas de integración (se vacía en cada prueba)
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/comercioclaro_test"

# Clave para firmar sesiones. OBLIGATORIA en producción (mínimo 32 caracteres).
# Genera una con: openssl rand -base64 48
JWT_SECRET=""

# URL pública de la app (se usa en los enlaces de los correos)
APP_URL="http://localhost:3000"

# Correo transaccional con Resend (https://resend.com). Sin clave, en desarrollo
# los correos se imprimen en la consola.
RESEND_API_KEY=""
EMAIL_FROM="ComercioClaro <no-reply@tudominio.com>"

# Alertas diarias de inventario: el cron llama GET /api/cron/low-stock
# con el encabezado Authorization: Bearer $CRON_SECRET
CRON_SECRET=""

# Facturación electrónica CFDI 4.0 con Facturama (opcional)
FACTURAMA_USER=""
FACTURAMA_PASSWORD=""
# true = ambiente de pruebas (apisandbox.facturama.mx)
FACTURAMA_SANDBOX="true"

# Factura electrónica DGI Panamá con un PAC (opcional).
# Sin credenciales se puede usar el PAC "simulado" para probar el flujo completo.
ALANUBE_API_URL=""
ALANUBE_TOKEN=""
# true = el PAC simulado responde "no disponible" (para probar la contingencia)
PAC_SIMULATE_OUTAGE=""

# Cobro automático con Yappy Comercial (Banco General). Sin YAPPY_PROVIDER=bg se usa
# el simulador, que confirma el pago a los pocos segundos.
YAPPY_PROVIDER=""
YAPPY_MERCHANT_ID=""
YAPPY_SECRET_KEY=""
YAPPY_DOMAIN=""
YAPPY_API_URL=""
YAPPY_SIMULATED_DELAY_MS="5000"

# Campañas por WhatsApp. Sin configurar, el envío es asistido (enlace por cliente).
# cloud = API de WhatsApp Business de Meta; simulado = para pruebas.
WHATSAPP_PROVIDER=""
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Cobro en línea de la suscripción ("Mi plan"). Sin configurar, solo pagos registrados por el super admin.
# stripe = Stripe Checkout y renovaciones con la tarjeta guardada; simulado = para pruebas (tarjetas 4242 y 0002).
# Webhook de Stripe: https://TU-DOMINIO/api/billing/webhook (checkout.session.completed,
# checkout.session.expired, payment_intent.succeeded, payment_intent.payment_failed).
# El cron diario GET /api/cron/billing avisa, cobra, reintenta y suspende.
BILLING_PROVIDER=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Correo de contacto que aparece en los términos y el aviso de privacidad
SUPPORT_EMAIL=""

# Seguridad: el panel del super admin exige la verificación en dos pasos (false solo para desarrollo).
ADMIN_MFA_REQUIRED="true"
# Proxys de confianza delante de la app (1 en Vercel o detrás de un nginx): de qué posición de
# x-forwarded-for se toma la IP del cliente para los límites de intentos.
TRUSTED_PROXY_HOPS="1"
